# Server environment for `snails harness test` — sourced into the server
# subshell only, so the test process keeps a clean ENV.
#
# SNAILS_ENV=test switches the app to test mode; mail is then captured into
# tmp/mail-capture.jsonl instead of sent. Add other app-only test switches
# (tokens, intervals) here.
#
# PORT= is the engine's: a line here does not move the gate's server.
SNAILS_ENV=test
