# Environment variables — a template, not configuration.
#
# The app does not read this file. Copy it to .env (gitignored), uncomment
# what you need, and source it before a command:
#
#   cp .env.sample .env
#   set -a; . ./.env; set +a
#
# SNAILS_ENV is the app mode: development (default), test, staging, production.
# SNAILS_ENV=development

# The app's signing key — required only when the app signs values (JWT, tokens).
# Read it through `Snails.app.secret_key_base`; unset or empty raises.
# Generate one with: openssl rand -hex 64
# SECRET_KEY_BASE=

# HTTP server (bin/<app>) — CLI flags -p/-w override these.
# PORT=3000
# WORKERS=1

# SQLite adapter (the scaffold default). A relative path is resolved from
# the spin root; the adapter creates the file on first use.
# DATABASE_PATH=storage/development.sqlite3
# DATABASE_POOL_SIZE=8

# PostgreSQL adapter — switch config/database.rb to the postgresql backend
# first. PG_URL is required by that adapter.
# PG_URL=postgres://user:password@127.0.0.1:5432/app_development
# compose deployment (compose.yml): POSTGRES_PASSWORD is shared by PG_URL and
# the postgres container. Set it before the first `up` — postgres keeps the
# first volume's password — and use URL-safe characters (letters, digits,
# -._~) because the value goes into PG_URL as-is.
# POSTGRES_PASSWORD=

# bin/dev with the PostgreSQL adapter starts a development container named
# from APP_NAME (pins.toml). These override its name/port/database.
# PG_CONTAINER_NAME=app-dev-pg
# PG_PORT=5433
# PG_DATABASE=app_development

# Single-host compose deployment (compose.yml): the container runs as
# PUID:PGID so the ./storage bind mount stays owned by you — the host can
# then run migrations and backups on it directly. The defaults fit the
# usual uid 1000; set them when your user id differs. compose reads .env
# by itself, so these need no sourcing.
# PUID=1000
# PGID=1000

# The app sets the process zone with Snails.time_zone in config/environment.rb.
# Do not set TZ here; change that line instead.

# The test harness sets SNAILS_ENV=test in harness/test.env. If the app signs,
# put a test-only SECRET_KEY_BASE there as well (never a production key).
