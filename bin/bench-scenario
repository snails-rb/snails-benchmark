#!/bin/bash
# Measure GET /items/:id for the application scenario: one primary-key read,
# a row mapping, and the same JSON body on both apps. This is the second
# benchmark suite; the /up microbenchmark stays in bin/bench.
#
# One command runs the whole suite: the baseline and the app containers each
# start on their own port, the VU levels are swept, and rounds interleave the
# targets so a slow drift on the machine hits all of them equally.
#
# The load generator is pinned to its own hardware threads. Without that split
# the generator and the server fight for the same cores and the server's share
# shrinks as load rises, which is what makes a same-host comparison misleading.
#
# Usage: bin/bench-scenario [options]
#
#   --targets LIST    comma-separated subset of TARGETS (default: baseline,snails,rails-cluster)
#   --vus LIST        comma-separated concurrency levels (default: 8,32,64,128)
#   --duration SEC    seconds per measurement (default: 20s)
#   --repeat N        rounds over every target and VU level (default: 3)
#   --logging on|off  request logging profile (default: off)
#   --build           rebuild both app images first
#   --server-cpus S   coreset for the server containers (default: all but load)
#   --load-cpus S     coreset for the generator (default: hardware threads 0-3)
#   --out DIR         result directory (default: results/scenario/<UTC timestamp>)
#
# Exit: 0 when every measurement ran and no request failed; 1 otherwise.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HARNESS="$ROOT/harness/scenario.js"
OUT="${OUT:-}"

TARGETS="baseline,snails,rails-cluster"
VUS_LIST="8,32,64,128"
DURATION="20s"
REPEAT=3
LOGGING="off"
BUILD=0

# The expected item 1 from the shared seed. Both apps and the static baseline
# must answer exactly this body, so a wrong fixture or a route mismatch fails
# before the load starts.
EXPECTED_ITEM='{"id":1,"name":"item-1","description":"description-1","price":101,"status":"inactive"}'

declare -A PORTS=(
  [baseline]=18090
  [snails]=18091
  [rails-cluster]=18092
  [rails-default]=18093
)

usage() {
  # The header comment is the help text; printing it straight means the two
  # cannot drift apart.
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "${BASH_SOURCE[0]}"
}

while (($#)); do
  case "$1" in
    --targets)  TARGETS="${2:?--targets needs a list}"; shift 2 ;;
    --vus)      VUS_LIST="${2:?--vus needs a list}"; shift 2 ;;
    --duration) DURATION="${2:?--duration needs a value}"; shift 2 ;;
    --repeat)   REPEAT="${2:?--repeat needs a number}"; shift 2 ;;
    --logging)  LOGGING="${2:?--logging needs on or off}"; shift 2 ;;
    --build)    BUILD=1; shift ;;
    --server-cpus) SERVER_CPUS="${2:?}"; shift 2 ;;
    --load-cpus)   LOAD_CPUS="${2:?}"; shift 2 ;;
    --out)      OUT="${2:?--out needs a path}"; shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    *) echo "bin/bench-scenario: unknown argument: $1 (try --help)" >&2; exit 2 ;;
  esac
done

case "$LOGGING" in
  on|off) ;;
  *) echo "bin/bench-scenario: --logging must be on or off" >&2; exit 2 ;;
esac

TOTAL_CPUS="$(nproc)"

# Count the logical CPUs named by a Linux cpuset string such as "4-15" or
# "0,4-7". Docker accepts the same shape, so a --server-cpus override must
# drive the Rails worker count rather than the host's total.
cpuset_count() {
  local set="$1" part start end count=0
  IFS=',' read -ra parts <<<"$set"
  for part in "${parts[@]}"; do
    if [[ $part =~ ^([0-9]+)-([0-9]+)$ ]]; then
      start=${BASH_REMATCH[1]}
      end=${BASH_REMATCH[2]}
      (( end >= start )) || return 1
      (( count += end - start + 1 ))
    elif [[ $part =~ ^[0-9]+$ ]]; then
      (( count += 1 ))
    else
      return 1
    fi
  done
  printf '%s' "$count"
}

cpuset_contains() {
  local set="$1" wanted="$2" part start end cpu
  IFS=',' read -ra parts <<<"$set"
  for part in "${parts[@]}"; do
    if [[ $part =~ ^([0-9]+)-([0-9]+)$ ]]; then
      start=${BASH_REMATCH[1]}
      end=${BASH_REMATCH[2]}
      for ((cpu = start; cpu <= end; cpu++)); do
        [[ $cpu == "$wanted" ]] && return 0
      done
    elif [[ $part =~ ^[0-9]+$ && $part == "$wanted" ]]; then
      return 0
    fi
  done
  return 1
}

require_disjoint_cpusets() {
  local load_set="$1" server_set="$2" cpu
  for ((cpu = 0; cpu < TOTAL_CPUS; cpu++)); do
    if cpuset_contains "$load_set" "$cpu" && cpuset_contains "$server_set" "$cpu"; then
      echo "bin/bench-scenario: load and server cpusets overlap on CPU $cpu" >&2
      return 1
    fi
  done
}

for cmd in docker jq curl taskset; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "bin/bench-scenario: $cmd is required" >&2
    exit 1
  }
done
if (( TOTAL_CPUS < 8 )); then
  echo "bin/bench-scenario: needs at least 8 cores to separate load from server (found $TOTAL_CPUS)" >&2
  exit 1
fi
LOAD_CPUS="${LOAD_CPUS:-0-3}"
SERVER_CPUS="${SERVER_CPUS:-4-$((TOTAL_CPUS - 1))}"
LOAD_CORE_COUNT="$(cpuset_count "$LOAD_CPUS")" || {
  echo "bin/bench-scenario: invalid --load-cpus: $LOAD_CPUS" >&2
  exit 1
}
SERVER_CORE_COUNT="$(cpuset_count "$SERVER_CPUS")" || {
  echo "bin/bench-scenario: invalid --server-cpus: $SERVER_CPUS" >&2
  exit 1
}
if (( LOAD_CORE_COUNT < 1 || SERVER_CORE_COUNT < 1 )); then
  echo "bin/bench-scenario: --load-cpus and --server-cpus must each name at least one CPU" >&2
  exit 1
fi
require_disjoint_cpusets "$LOAD_CPUS" "$SERVER_CPUS" || exit 1
DURATION_S="${DURATION%s}"
[[ $DURATION_S =~ ^[0-9]+$ ]] || {
  echo "bin/bench-scenario: --duration must be a whole number of seconds (for example 15s)" >&2
  exit 2
}
OUT="${OUT:-$ROOT/results/scenario/$(date -u +%Y%m%dT%H%M%SZ)}"

mkdir -p "$OUT/raw"

# k6 from mise keeps the generator version constant; the pinned minor is the
# one the microbenchmark uses, so the two suites share one generator.
if mise exec k6@2.3.0 -- k6 version >/dev/null 2>&1; then
  K6_LOCAL="mise exec k6@2.3.0 --"
else
  echo "bin/bench-scenario: k6 not available through mise; install it with 'mise use -g k6@2.3.0'" >&2
  exit 1
fi

run_k6() {
  local base_url="$1" vus="$2" name="$3"
  local export="$OUT/raw/$name.json"
  # shellcheck disable=SC2086
  taskset -c "$LOAD_CPUS" $K6_LOCAL k6 run \
    -e BASE_URL="$base_url" -e VUS="$vus" -e DURATION="$DURATION" \
    --quiet --no-color --summary-mode compact \
    --summary-export "$export" "$HARNESS" >"$OUT/raw/$name.log" 2>&1
}

# Peak memory while a load runs, from the container's cgroup counter. The
# counter is a high-water mark through the whole sweep, not a per-condition
# peak; docs/method.md names that limitation.
sample_peak_memory() {
  local target="$1" samples="$2" interval="$3"
  docker exec "bench-$target" sh -c "
    i=0; peak=0
    while [ \$i -lt $samples ]; do
      v=\$(cat /sys/fs/cgroup/memory.current 2>/dev/null || cat /sys/fs/cgroup/memory/memory.usage_in_bytes 2>/dev/null || echo 0)
      [ \"\$v\" -gt \"\$peak\" ] && peak=\$v
      i=\$((i + 1))
      sleep $interval
    done
    echo \$peak
  " 2>/dev/null || echo 0
}

start_memory_sampler() {
  local target="$1" duration_s="$2"
  PEAK_FILE="/tmp/bench-scenario-peak-$target"
  rm -f "$PEAK_FILE"
  local ticks=$(( duration_s * 20 ))
  ( sample_peak_memory "$target" "$ticks" 0.05 >"$PEAK_FILE" ) &
  SAMPLER_PID=$!
}

wait_for_up() {
  local target="$1" port="$2" i
  for ((i = 0; i < 120; i++)); do
    if curl -fsS "http://127.0.0.1:$port/items/1" >/dev/null 2>&1; then
      return 0
    fi
    if [[ -z $(docker ps --filter "name=^bench-$target$" --format '{{.Names}}') ]]; then
      return 1
    fi
    sleep 1
  done
  return 1
}

verify_item() {
  local target="$1" port="$2" actual
  actual="$(curl -fsS "http://127.0.0.1:$port/items/1" | jq -S -c . 2>/dev/null || true)"
  if [[ $actual != "$(jq -S -c . <<<"$EXPECTED_ITEM")" ]]; then
    echo "bin/bench-scenario: $target returned an unexpected /items/1 body: ${actual:-<empty>}" >&2
    return 1
  fi
}

start_target() {
  local target="$1" port="${PORTS[$1]:-}" logging_env=() rails_log=()
  [[ -n $port ]] || { echo "bin/bench-scenario: unknown target: $target" >&2; return 1; }
  if [[ $LOGGING == off ]]; then
    logging_env=(-e SNAILS_LOG_LEVEL=fatal)
    rails_log=(-e RAILS_LOG_LEVEL=fatal)
  fi
  docker rm -f "bench-$target" >/dev/null 2>&1 || true
  case "$target" in
    baseline)
      docker run -d --name "bench-$target" --cpuset-cpus "$SERVER_CPUS" \
        -p "127.0.0.1:$port:3000" \
        -v "$ROOT/baseline/static-json.conf:/etc/nginx/conf.d/default.conf:ro" \
        nginx:alpine >/dev/null
      ;;
    snails)
      docker run -d --name "bench-$target" --cpuset-cpus "$SERVER_CPUS" \
        "${logging_env[@]}" \
        -e DATABASE_POOL_SIZE="$(( SERVER_CORE_COUNT * 5 ))" \
        -p "127.0.0.1:$port:3000" snails-scenario:bench >/dev/null
      ;;
    rails-cluster)
      # Same shape as the microbenchmark's fair Rails target: one worker per
      # server hardware thread, five threads each, preload, jemalloc, and a
      # precompiled bootsnap cache from the image.
      docker run -d --name "bench-$target" --cpuset-cpus "$SERVER_CPUS" \
        -e WEB_CONCURRENCY="$SERVER_CORE_COUNT" -e RAILS_MAX_THREADS=5 \
        "${rails_log[@]}" \
        -e SECRET_KEY_BASE=benchmark-only-not-a-deployment-secret-0000000000 \
        -p "127.0.0.1:$port:3000" rails-scenario:bench >/dev/null
      ;;
    rails-default)
      # The generated Rails default shape: one process, three threads.
      docker run -d --name "bench-$target" --cpuset-cpus "$SERVER_CPUS" \
        -e WEB_CONCURRENCY=0 -e RAILS_MAX_THREADS=3 \
        "${rails_log[@]}" \
        -e SECRET_KEY_BASE=benchmark-only-not-a-deployment-secret-0000000000 \
        -p "127.0.0.1:$port:3000" rails-scenario:bench >/dev/null
      ;;
  esac
  wait_for_up "$target" "$port" || return 1
  verify_item "$target" "$port" || return 1
}

stop_target() {
  docker rm -f "bench-$1" >/dev/null 2>&1 || true
}

if (( BUILD )); then
  echo "[scenario] building images"
  ( cd "$ROOT/apps/scenario/snails" && IMAGE=snails-scenario bin/build-image --tag bench >/dev/null )
  docker build -q -f "$ROOT/apps/scenario/rails-api/Dockerfile" \
    -t rails-scenario:bench "$ROOT/apps/scenario" >/dev/null
fi

echo "[scenario] host: $TOTAL_CPUS cores, servers on $SERVER_CPUS, load on $LOAD_CPUS"
echo "[scenario] duration: $DURATION, rounds: $REPEAT, VUs: $VUS_LIST, logging: $LOGGING"
echo "[scenario] results: $OUT"

{
  printf 'suite\tscenario\tduration\trounds\tvus\ttargets\tlogging\tserver_cpus\tload_cpus\n'
  printf 'scenario\titem-read\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$DURATION" "$REPEAT" "$VUS_LIST" "$TARGETS" "$LOGGING" "$SERVER_CPUS" "$LOAD_CPUS"
} >"$OUT/run.tsv"

FAILED=0
SUMMARY="$OUT/summary.tsv"
printf 'target\tvus\tround\trps\tp50_ms\tp95_ms\tp99_ms\tfailed_pct\tpeak_mib\n' >"$SUMMARY"

RUNNING=()
cleanup() {
  for t in "${RUNNING[@]:-}"; do
    [[ -n $t ]] && stop_target "$t"
  done
}
trap cleanup EXIT

IFS=',' read -ra TARGET_LIST <<<"$TARGETS"
TARGET_COUNT=${#TARGET_LIST[@]}
(( TARGET_COUNT > 0 )) || {
  echo "bin/bench-scenario: --targets must name at least one target" >&2
  exit 2
}

for target in "${TARGET_LIST[@]}"; do
  echo "[scenario] starting $target"
  if ! start_target "$target"; then
    echo "[scenario] $target did not become ready — skipping" >&2
    docker logs "bench-$target" 2>&1 | tail -5 >&2 || true
    stop_target "$target"
    FAILED=1
    continue
  fi
  RUNNING+=("$target")
  run_k6 "http://127.0.0.1:${PORTS[$target]}" 8 "warmup-$target" || true
done

# The query plan is part of the fixture evidence: both apps read the same table
# with a primary-key equality, and db.tsv records that the plan is a PK lookup.
if [[ -n $(docker ps --filter "name=^bench-snails$" --format '{{.Names}}') ]]; then
  {
    printf 'target\tplan\n'
    plan="$(docker exec bench-snails sqlite3 /app/storage/bench.sqlite3 \
      "EXPLAIN QUERY PLAN SELECT id, name, description, price, status FROM items WHERE id = 1" \
      | paste -sd ';' - | tr '\t' ' ')"
    printf 'snails\t%s\n' "$plan"
  } >"$OUT/db.tsv"
fi

sleep 3

# Rotate target order per round and VU level so a within-round drift does not
# always hit the same target last. The rounds remain the outer loop.
vus_index=0
for ((round = 1; round <= REPEAT; round++)); do
  for vus in ${VUS_LIST//,/ }; do
    for ((order = 0; order < TARGET_COUNT; order++)); do
      target="${TARGET_LIST[$(( (order + round + vus_index) % TARGET_COUNT ))]}"
      port="${PORTS[$target]:-}"
      [[ -n $port ]] || continue
      [[ -n $(docker ps --filter "name=^bench-$target$" --format '{{.Names}}') ]] || continue
      name="$target-vus$vus-round$round"
      start_memory_sampler "$target" "$DURATION_S"
      if ! run_k6 "http://127.0.0.1:$port" "$vus" "$name"; then
        echo "[scenario] $name failed — see raw/$name.log" >&2
        wait "$SAMPLER_PID" 2>/dev/null || true
        rm -f "$PEAK_FILE"
        FAILED=1
        continue
      fi
      wait "$SAMPLER_PID" 2>/dev/null || true
      peak_bytes="$(cat "$PEAK_FILE" 2>/dev/null || echo 0)"
      rm -f "$PEAK_FILE"
      peak_mib=$(( peak_bytes / 1048576 ))
      read -r rps p50 p95 p99 failed < <(
        jq -r '[
          .metrics.http_reqs.rate,
          .metrics.http_req_duration["p(50)"],
          .metrics.http_req_duration["p(95)"],
          .metrics.http_req_duration["p(99)"],
          (.metrics.http_req_failed.value * 100)
        ] | @tsv' "$OUT/raw/$name.json"
      )
      printf '%s\t%s\t%s\t%.1f\t%.2f\t%.2f\t%.2f\t%.2f\t%s\n' \
        "$target" "$vus" "$round" "$rps" "$p50" "$p95" "$p99" "$failed" "$peak_mib" >>"$SUMMARY"
      printf '  %-18s round=%s vus=%-4s %9.1f rps  p50=%6.2fms p95=%8.2fms  peak=%4s MiB\n' \
        "$target" "$round" "$vus" "$rps" "$p50" "$p95" "$peak_mib"
    done
    vus_index=$((vus_index + 1))
  done
done

echo
printf 'target\tmem_usage\tmem_pct\tcpu_pct\tpids\n' >"$OUT/memory.tsv"
for target in "${RUNNING[@]:-}"; do
  [[ -n $target ]] || continue
  row="$(docker stats --no-stream --format '{{.Name}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.CPUPerc}}\t{{.PIDs}}' "bench-$target" 2>/dev/null || true)"
  [[ -n $row ]] || continue
  row="${target}"$'\t'"$(printf '%s' "$row" | cut -f2-)"
  printf '%s\n' "$row" >>"$OUT/memory.tsv"
done

echo
"$ROOT/bin/report" "$OUT"

echo
echo "[scenario] raw: $OUT/raw, table: $SUMMARY"
if (( FAILED )); then
  echo "[scenario] at least one measurement failed" >&2
  exit 1
fi
